# LLM backend: "ollama" (local, default) or "openai"
ADVISOR_LLM=ollama

# Ollama settings
ADVISOR_OLLAMA_MODEL=qwen3:4b
ADVISOR_OLLAMA_EMBED_MODEL=nomic-embed-text
ADVISOR_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI settings (only used when ADVISOR_LLM=openai)
OPENAI_API_KEY=
ADVISOR_OPENAI_MODEL=gpt-4o-mini
ADVISOR_OPENAI_EMBED_MODEL=text-embedding-3-small
